# Repo policy: text files use LF in both repo and working tree.
#
# Why: deploy.js (in 4veco-platform) writes LF-terminated files into this
# repo. Windows core.autocrlf=true previously converted those to CRLF on
# checkout, producing a "modified" flag on every deploy even when content
# was unchanged. Pinning eol=lf removes the mismatch.

* text=auto eol=lf

# Known binary types — disable line-ending normalization explicitly.
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Archived records preserve the original Git blob bytes.
archive/** -text

# Delivered Book 2 edition: preserve original bytes, including searchable text.
"Boek 2 - Kosten, opbrengsten, elasticiteit en surplus/edities/chat-2026/**" -text

# Selected Books 3/4: preserve supplied bytes, including searchable text.
"Boek 3 - Overheidsingrijpen, concurrentie en internationale handel/edities/chat-2026/**" -text
"Boek 4 - Monopolie, marktfalen en arbeidsmarkt/edities/chat-2026/**" -text

# Original delivery whitespace is provenance; generated navigation stays checked.
"Boek 3 - Overheidsingrijpen, concurrentie en internationale handel/edities/chat-2026/pakket/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
"Boek 3 - Overheidsingrijpen, concurrentie en internationale handel/edities/chat-2026/source_chapters/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
"Boek 4 - Monopolie, marktfalen en arbeidsmarkt/edities/chat-2026/pakket/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# Immutable received v3 delivery, including supplied text line endings.
edities/books34-v3/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
